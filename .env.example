# This is an example environment file for the DraftDB project.
# It contains the necessary environment variables for configuring the PostgreSQL database connection.

POSTGRES_USER=draftdb
POSTGRES_PASSWORD=draftdb
POSTGRES_DB=draftdb

# Utilisées par l'API uniquement : où joindre la base depuis la machine hôte
# (5433 est le port publié par docker-compose.yml)

POSTGRES_HOST=localhost
POSTGRES_PORT=5433